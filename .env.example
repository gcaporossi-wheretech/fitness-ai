# Database
DB_USER=fitnessai
DB_PASSWORD=changeme
DB_NAME=fitness_ai
DATABASE_URL=postgresql+asyncpg://fitnessai:changeme@db:5432/fitness_ai

# JWT (shared across all services for token validation)
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Anthropic (Claude API) — used by AI service
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Redis — used by AI service
REDIS_URL=redis://redis:6379/0

# App
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
